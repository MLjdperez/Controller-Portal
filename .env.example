# Postgres for this portal (never the budget app's database).
DATABASE_URL="postgresql://portal:portal_dev_only@127.0.0.1:5433/controller_portal?schema=public"
# Where original uploaded files are kept (Railway volume mount in production).
STORAGE_DIR="./storage"
# Seed: the first Controller account. Its password is generated and written to credentials.local.csv.
SEED_ADMIN_EMAIL="controller@example.com"
SEED_ADMIN_NAME="Controller"

# Ask Claude (Anthropic API). Leave empty to disable the feature.
ANTHROPIC_API_KEY=""
